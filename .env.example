# ======================================================================================
# Garage Management System configuration. Copy to .env and change the values marked (!)
# Tip: ./scripts/init-env.sh creates .env with strong random passwords for you.
# ======================================================================================

# --- Database ---------------------------------------------------------------------------
POSTGRES_USER=gms
# (!) Use a long random password.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=gms

# --- First admin account -----------------------------------------------------------------
# Created on first start only (when there are no users). You must change it at first sign-in.
INITIAL_ADMIN_USERNAME=admin
# (!) At least 8 characters with letters and numbers.
INITIAL_ADMIN_PASSWORD=change-me-123

# --- Web / HTTPS ---------------------------------------------------------------------------
# For internet access set ENABLE_HTTPS=true, DOMAIN to your domain (DNS A record -> this server)
# and LETSENCRYPT_EMAIL. A free certificate is obtained and renewed automatically.
ENABLE_HTTPS=false
DOMAIN=
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false
HTTP_PORT=80
HTTPS_PORT=443
# Session cookies are HTTPS-only automatically when ENABLE_HTTPS=true. Override only if you terminate
# HTTPS somewhere else (e.g. a cloud load balancer): COOKIE_SECURE=true

# --- Application ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
SESSION_HOURS=12
WEB_WORKERS=2

# --- Backups -------------------------------------------------------------------------------
# Folder on this server where daily backups are written (keep a copy off the server too!).
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30
TZ=Asia/Colombo
